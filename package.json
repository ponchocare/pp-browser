{
  "name": "@ponchopay/pp-browser",
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponchocare/pp-browser.git"
  },
  "description": "Tools to integrate PonchoPay on the browser",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "dist/src/index.d.ts",
      "import": "dist/src/index.js"
    },
    "./pp-payment": {
      "types": "dist/src/PpPayment.d.ts",
      "import": "dist/src/PpPayment.js"
    },
    "./pp-subscription": {
      "types": "dist/src/PpSubscription.d.ts",
      "import": "dist/src/PpSubscription.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "clean": "rimraf build dist",
    "start": "npm run clean && tsc --outDir example/dist && concurrently -k -r \"tsc --watch --preserveWatchOutput --outDir example/dist\" \"vite --open\"",
    "build": "npm run clean && tsc && rollup -c",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint . --fix && prettier \"**/*.ts\" --write --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@open-wc/eslint-config": "^13.1.0",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-terser": "^1.0.2",
    "concurrently": "^5.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "jsdom": "^26.0.0",
    "prettier": "^2.4.1",
    "rimraf": "^6.1.4",
    "rollup": "^3.29.0",
    "tslib": "^2.9.1",
    "typescript": "^4.5.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "ponchopay",
    "web",
    "component",
    "tools"
  ],
  "author": "info@ponchopay.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ponchocare/pp-browser/issues"
  },
  "homepage": "https://github.com/ponchocare/pp-browser#readme",
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  }
}
